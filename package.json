{
  "name": "readlens-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "submission:check": "npm run check && npm run format:check && npm run security:check",
    "security:check": "node scripts/check-public-files.mjs",
    "config:check": "node scripts/check-config.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start:ios": "expo start --dev-client --ios",
    "start:android": "expo start --dev-client --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test src/**/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@config-plugins/react-native-blob-util": "^14.0.2",
    "@config-plugins/react-native-pdf": "^14.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.20",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-image-picker": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.24.10",
    "react-native-confirmation-code-field": "^9.0.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pdf": "^7.0.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "sonner-native": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
