# Set true for the browser/sample preview; false for real iOS/Android API integration.
# Missing/false defaults to live mode; it never silently falls back to sample data.
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_API_URL=https://dev.api.readlens.app/api/v1
# Assessment-only gateway credentials. Never commit real values.
# EXPO_PUBLIC values are bundled into the app and are not production secrets.
EXPO_PUBLIC_BASIC_AUTH_USERNAME=
EXPO_PUBLIC_BASIC_AUTH_PASSWORD=
